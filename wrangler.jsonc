{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-08",
  "name": "quiztimeplay",
  "main": "src/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 */12 * * *"]
  }
}