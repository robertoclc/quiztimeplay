
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-08",
  "name": "quiztimeplay",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.25,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
  "triggers": {
    "crons": [
      "0 */12 * * *"
    ]
  }
}
