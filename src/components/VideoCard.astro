---
interface Props {
    title: string;
    thumbnail: string;
    category: string;
    duration: string;
    publishedAt: string;
    url: string;
}

const {
    title,
    thumbnail,
    category,
    duration,
    publishedAt,
    url
} = Astro.props;

const publishedDate = new Date(publishedAt);

const today = new Date();

const diffDays = Math.floor(
    (today.getTime() - publishedDate.getTime()) /
    (1000 * 60 * 60 * 24)
);

const isNew = diffDays <= 7;
---

<a
    class="video-card"
    href={url}
    target="_blank"
    rel="noopener noreferrer"
>

    <div class="thumb">

    <img
        src={thumbnail}
        alt={title}
        width="480"
        height="360"
        loading="lazy"
        decoding="async"
    />

        {
            isNew && (
                <span class="badge new">
                    🆕 NOVO
                </span>
            )
        }

        <span class="video-duration">
            {duration}
        </span>

    </div>

    <div class="info">

        <span class="category">
            {category}
        </span>

        <h3>
            {title}
        </h3>

        <span class="watch-button">
    ▶ Assistir no YouTube
        </span>

    </div>

</a>