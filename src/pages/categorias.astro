---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/categorias.css";

import { getPlaylists } from "../services/playlists";

const playlists = await getPlaylists();
---

<Layout
    title="Categorias | QuizTimePlay"
    description="Escolha uma categoria e encontre quizzes de História, Futebol, Bíblia, Geografia, Ciências, Filmes, Turismo, Música e muito mais para assistir no canal Quiz Time - Teste Seus Conhecimentos no YouTube."
    canonical="https://quiztimeplay.com.br/categorias"
>

<Header />

<section class="hero">

    <div class="container hero-content">

        <div class="hero-text">

            <span class="badge">

                📚 Explore por Categoria

            </span>

            <h1>

                Quizzes por Categoria

            </h1>

            <p>

                Explore quizzes de Conhecimentos Gerais, História, Ciências, Bíblia, Turismo, Futebol, Esportes, Cultura
                Pop, Filmes, Música, Desafios e muito mais. Escolha uma categoria e assista gratuitamente aos desafios
                completos no canal Quiz Time - Teste Seus Conhecimentos no YouTube.
            </p>

        </div>

    </div>

</section>

<section class="categories">

    <div class="container">

        <div class="categories-grid">

            {

                playlists.map((playlist) => (

                    <a

                        href={playlist.playlistUrl}

                        target="_blank"

                        class="category-card"

                    >

                        <img

                            src={playlist.thumbnail}

                            alt={playlist.title}

                            class="playlist-thumb"

                            loading="lazy"

                        />

                        <div class="card-content">

                            <div class="icon">

                                {playlist.icon}

                            </div>

                            <h2>

                                {playlist.title}

                            </h2>

                            <p>

                                {playlist.description}

                            </p>

                            <span class="explore">

                                ▶ Explorar Playlist

                            </span>

                        </div>

                    </a>

                ))

            }

        </div>

    </div>

</section>

<Footer />

</Layout>