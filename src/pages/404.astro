---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Página não encontrada | QuizTimePlay"
    description="A página que você procura não existe. Continue assistindo aos melhores quizzes do YouTube no QuizTimePlay."
>

<Header />

<section class="hero">

    <div class="container hero-content">

        <div class="hero-text">

            <span class="badge">
                ⚠️ Página não encontrada
            </span>

            <h1>
                Ops! Este quiz não foi encontrado.
            </h1>

            <p>
                A página que você tentou acessar não existe ou foi movida.
                Mas você pode continuar testando seus conhecimentos com
                centenas de quizzes disponíveis em nosso canal.
            </p>

            <div class="hero-buttons">

                <a href="/#quizzes" class="btn">
                    ▶ Começar um Quiz Agora
                </a>

                <a
                    href="https://www.youtube.com/@QuizTime-Tc?sub_confirmation=1"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-secondary">

                    ▶ Inscreva-se no YouTube

                </a>

            </div>

        </div>

    </div>

</section>

<Footer />

</Layout>