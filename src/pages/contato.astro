---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Contato | QuizTimePlay"
    description="Entre em contato com o QuizTimePlay."
>

<Header />

<section class="hero hero-small">

    <div class="container hero-content">

        <div class="hero-text">

            <span class="badge">
                📬 Contato
            </span>

            <h1>
                Fale com o QuizTimePlay
            </h1>

            <p>
                Tem alguma sugestão, encontrou algum erro
                ou deseja falar sobre parcerias?
                Será um prazer conversar com você.
            </p>

        </div>

    </div>

</section>

<section class="contact-section">

    <div class="container">

        <div class="contact-card">

            <h2>📧 E-mail</h2>

            <a
                href="mailto:contato@quiztimeplay.com.br"
                class="email">

                contato@quiztimeplay.com.br

            </a>

            <a
                href="mailto:contato@quiztimeplay.com.br"
                class="btn-contact">

                📨 Enviar E-mail

            </a>

            <hr>

            <h2>📺 Canal Oficial</h2>

            <p>

                Acompanhe todos os nossos quizzes diretamente no YouTube.

            </p>

            <a

                href="https://www.youtube.com/@QuizTime-Tc"

                target="_blank"

                rel="noopener noreferrer"

                class="btn-contact">

                ▶ Inscrever-se no Canal

            </a>

        </div>

    </div>

</section>

<Footer />

</Layout>

<style>

.hero-small{

    padding:55px 20px 35px;

}

.hero-small h1{

    font-size:52px;

}

.hero-small p{

    max-width:700px;

    margin:auto;

}

.contact-section{

    padding:40px 20px 70px;

}

.contact-section .container{

    max-width:760px;

    margin:auto;

}

.contact-card{

    background:#1f2937;

    border:1px solid rgba(255,255,255,.08);

    border-radius:20px;

    padding:35px;

    text-align:center;

    box-shadow:0 10px 30px rgba(0,0,0,.25);

}

.contact-card h2{

    font-size:28px;

    color:#fff;

    margin-bottom:15px;

}

.contact-card p{

    color:#cbd5e1;

    font-size:18px;

    margin-bottom:20px;

    line-height:1.6;

}

.email{

    display:block;

    margin-bottom:25px;

    color:#60a5fa;

    font-size:24px;

    font-weight:700;

    text-decoration:none;

    word-break:break-word;

}

.btn-contact{

    display:inline-block;

    background:#2563eb;

    color:#fff;

    text-decoration:none;

    padding:16px 36px;

    border-radius:12px;

    font-size:18px;

    font-weight:700;

    transition:.25s;

}

.btn-contact:hover{

    background:#1d4ed8;

    transform:translateY(-2px);

}

hr{

    border:none;

    border-top:1px solid rgba(255,255,255,.12);

    margin:35px 0;

}

@media(max-width:768px){

    .hero-small h1{

        font-size:38px;

    }

    .contact-card{

        padding:28px;

    }

    .email{

        font-size:20px;

    }

}

</style>