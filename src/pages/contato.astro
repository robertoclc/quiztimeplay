---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/contact.css";
---

<!-- ==========================================================
     ARQUIVO: contato.astro
     CAMINHO: src/pages/contato.astro

     FINALIDADE
     Exibe a página de contato do QuizTimePlay.

     ESTE ARQUIVO CONTROLA
     • Título e descrição da página.
     • Estrutura do Hero de contato.
     • Informações de contato por e-mail.
     • Link para o canal do YouTube.
     • Exibição do Header e Footer.

     COMPONENTES UTILIZADOS
     • src/layouts/Layout.astro
     • src/components/Header.astro
     • src/components/Footer.astro

     ESTILOS
     • src/styles/contact.css
     • src/styles/responsive.css
       (somente regras para tablets e celulares)

     NÃO ALTERAR NESTE ARQUIVO
     • Cores, tamanhos, espaçamentos e aparência.
     • Responsividade.
     • Estilos dos botões, cards ou Hero.

     FUNCIONAMENTO
     • O endereço de e-mail utiliza um link mailto.
     • O botão do YouTube abre o canal oficial em nova aba.
     • A página utiliza o Layout global para SEO e estrutura HTML.

     OBSERVAÇÕES
     • Todo o CSS específico da página está centralizado em
       src/styles/contact.css.
     • As regras responsivas estão exclusivamente em
       src/styles/responsive.css.
========================================================== -->

<Layout
    title="Contato | QuizTimePlay"
    description="Entre em contato com o QuizTimePlay para enviar sugestões, dúvidas, parcerias ou falar sobre o canal Quiz Time - Teste Seus Conhecimentos no YouTube."
    canonical="https://quiztimeplay.com.br/contato"
>

<Header />

<section class="hero hero-contact">

    <div class="container">

        <span class="badge">
            📬 Contato
        </span>

        <h1>
            Fale com o QuizTimePlay
        </h1>

        <p>
            Envie suas sugestões, dúvidas, parcerias ou ideias para novos quizzes. Será um prazer conversar com você.
        </p>

    </div>

</section>

<section class="contact">

    <div class="container cards">

        <div class="card">

            <div class="emoji">
                📧
            </div>

            <h2>E-mail</h2>

            <p class="email">
                contato@quiztimeplay.com.br
            </p>

            <a
                href="mailto:contato@quiztimeplay.com.br"
                class="btn">

                📨 Enviar e-mail

            </a>

        </div>

        <div class="card">

            <div class="emoji">
                📺
            </div>

            <h2>YouTube</h2>

            <p>
                Assista a todos os quizzes completos do canal Quiz Time - Teste Seus Conhecimentos.
            </p>

            <a
                href="https://www.youtube.com/@QuizTime-Tc"
                target="_blank"
                rel="noopener noreferrer"
                class="btn">

                ▶ Ir para o canal

            </a>

        </div>

    </div>

</section>

<Footer />

</Layout>