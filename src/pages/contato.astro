---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Contato | QuizTimePlay"
    description="Entre em contato com o QuizTimePlay."
>

<Header />

<section class="hero hero-contact">

    <div class="container">

        <span class="badge">
            📬 Contato
        </span>

        <h1>Fale com o QuizTimePlay</h1>

        <p>
            Sugestões, dúvidas ou parcerias.
            Será um prazer conversar com você.
        </p>

    </div>

</section>

<section class="contact">

    <div class="container cards">

        <div class="card">

            <div class="emoji">📧</div>

            <h2>E-mail</h2>

            <p class="email">
                contato@quiztimeplay.com.br
            </p>

            <a
                href="mailto:contato@quiztimeplay.com.br"
                class="btn">

                📨 Enviar e-mail

            </a>

        </div>

        <div class="card">

            <div class="emoji">📺</div>

            <h2>YouTube</h2>

            <p>

                Conheça todos os nossos quizzes.

            </p>

            <a
                href="https://www.youtube.com/@QuizTime-Tc"
                target="_blank"
                rel="noopener noreferrer"
                class="btn">

                ▶ Ir para o canal

            </a>

        </div>

    </div>

</section>

<Footer />

</Layout>

<style>

.hero-contact{

    padding:45px 20px 25px;

    text-align:center;

}

.hero-contact h1{

    font-size:46px;

    margin:12px 0;

}

.hero-contact p{

    font-size:20px;

    color:#cbd5e1;

    max-width:650px;

    margin:auto;

}

.contact{

    padding:30px 20px 60px;

}

.cards{

    max-width:900px;

    margin:auto;

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:30px;

}

.card{

    background:#1f2937;

    border:1px solid rgba(255,255,255,.08);

    border-radius:18px;

    padding:30px;

    text-align:center;

    box-shadow:0 8px 20px rgba(0,0,0,.25);

}

.emoji{

    font-size:42px;

    margin-bottom:15px;

}

.card h2{

    color:#fff;

    font-size:28px;

    margin-bottom:15px;

}

.card p{

    color:#cbd5e1;

    font-size:18px;

    line-height:1.5;

    min-height:55px;

}

.email{

    color:#60a5fa !important;

    font-size:21px !important;

    font-weight:700;

    word-break:break-word;

}

.btn{

    display:inline-block;

    margin-top:20px;

    padding:15px 30px;

    background:#2563eb;

    color:#fff;

    text-decoration:none;

    border-radius:12px;

    font-weight:700;

    transition:.25s;

}

.btn:hover{

    background:#1d4ed8;

    transform:translateY(-2px);

}

@media(max-width:850px){

    .cards{

        grid-template-columns:1fr;

    }

    .hero-contact h1{

        font-size:36px;

    }

    .hero-contact p{

        font-size:18px;

    }

}

</style>