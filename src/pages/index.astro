---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HomeVideos from "../components/HomeVideos.astro";
import HomeShorts from "../components/HomeShorts.astro";
import Footer from "../components/Footer.astro";
import { getHomeContent } from "../services/youtube";

const { videos, shorts } = await getHomeContent();
---

<Layout
title="QuizTimePlay | Quizzes de Conhecimentos Gerais, História, Futebol, Bíblia, Ciências e Muito Mais"
description="Assista aos melhores quizzes gratuitos sobre Conhecimentos Gerais, História, Futebol, Bíblia, Ciências, Filmes, Turismo, Música, Cultura Pop e muito mais. Novos desafios a cada 15 dias no canal Quiz Time - Teste Seus Conhecimentos."
canonical="https://quiztimeplay.com.br/"
>

<Header />

<main>

    <Hero />

    <HomeVideos videos={videos} />

    <HomeShorts videos={shorts} />

    </main>

    <Footer />

</Layout>